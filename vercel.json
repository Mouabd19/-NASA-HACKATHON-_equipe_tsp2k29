{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": { "maxDuration": 60, "includeFiles": "server/vercel/dist/**" }
  },
  "redirects": [
    { "source": "/slides", "destination": "/slides/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/ingest", "destination": "/api/index?__p=/ingest" },
    { "source": "/ingest/:path*", "destination": "/api/index?__p=/ingest/:path*" },
    { "source": "/api/:path*", "destination": "/api/index?__p=/api/:path*" },
    { "source": "/slides/", "destination": "/slides/index.html" },
    { "source": "/((?!api/|api$|ingest/|ingest$|models/|data/|assets/|slides/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/models/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }] },
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }] }
  ]
}
